@@ -0,0 +1,33 @@
+package management
+
+import (
+	"testing"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func TestConfiguredQuotaCredentialVisibility(t *testing.T) {
+	h := &Handler{}
+	quota := authFileQuotaContext{v8: true, pluginIDs: map[string]string{"openai-compatible-ollama": "ollama-usage-monitor"}}
+	auth := &coreauth.Auth{ID: "configured-ollama", Provider: "openai-compatible-ollama", Status: coreauth.StatusActive,
+		Attributes: map[string]string{"source": "config:ollama[test]", "api_key": "private-test-key", "base_url": "https://ollama.com/v1"}}
+	if !isConfiguredQuotaAuth(auth, quota) {
+		t.Fatal("configured quota credential should pass pagination visibility")
+	}
+	entry := h.buildAuthFileEntry(auth, quota)
+	if entry == nil || entry["supports_quota"] != true || entry["quota_plugin_id"] != "ollama-usage-monitor" {
+		t.Fatalf("missing plugin quota entry: %#v", entry)
+	}
+	for key, value := range entry {
+		if key == "api_key" || key == "attributes" || value == "private-test-key" {
+			t.Fatal("credential material exposed")
+		}
+	}
+	if h.buildAuthFileEntry(auth, authFileQuotaContext{}) != nil {
+		t.Fatal("unmonitored config credential should remain hidden")
+	}
+	auth.Disabled = true
+	if isConfiguredQuotaAuth(auth, quota) || h.buildAuthFileEntry(auth, quota) != nil {
+		t.Fatal("disabled config credential should remain hidden")
+	}
+}
