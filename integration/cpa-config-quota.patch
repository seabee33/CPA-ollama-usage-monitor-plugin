+// isConfiguredQuotaAuth allows monitoring existing config credentials without
+// manufacturing auth files or changing their routing/persistence semantics.
+func isConfiguredQuotaAuth(auth *coreauth.Auth, quota authFileQuotaContext) bool {
+	if auth == nil || auth.Disabled || auth.Status == coreauth.StatusDisabled {
+		return false
+	}
+	return quota.v8 && strings.HasPrefix(authAttribute(auth, "source"), "config:") &&
+		quota.pluginIDs[strings.ToLower(strings.TrimSpace(auth.Provider))] != ""
+}
